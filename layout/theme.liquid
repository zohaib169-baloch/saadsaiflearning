<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Starter Theme</title>
    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'fur-link-hover.css' | asset_url | stylesheet_tag }}
    {{ 'fur-preloader.css' | asset_url | stylesheet_tag }}

<script
  src="{{ 'fur-link-hover.js' | asset_url }}"
  defer
></script>
</head>
<body>
  {% render 'fur-preloader' %}
    {% sections 'header-group' %}
    {{ content_for_layout }}
    {{ 'fur-cart-drawer.css' | asset_url | stylesheet_tag }}

<script
  src="{{ 'fur-cart-drawer.js' | asset_url }}"
  defer
></script>

{% render 'fur-cart-drawer' %}
{% sections 'footer-group' %}
<script
  src="{{ 'fur-preloader.js' | asset_url }}"
  defer
></script>
{% render 'fur-search-overlay' %}
</body>
</html>