{{ 'fur-collection.css' | asset_url | stylesheet_tag }}
{{ 'fur-product-card.css' | asset_url | stylesheet_tag }}

<script
  src="{{ 'fur-collection.js' | asset_url }}"
  defer
></script>

<script
  src="{{ 'fur-product-card.js' | asset_url }}"
  defer
></script>


<section
  class="fur-collection"
  data-fur-collection
  style="
    --fur-collection-columns-desktop: {{ section.settings.columns_desktop }};
    --fur-collection-columns-mobile: {{ section.settings.columns_mobile }};
    --fur-collection-gap: {{ section.settings.grid_gap }}px;
    --fur-collection-padding-x: {{ section.settings.padding_horizontal }}px;
    --fur-collection-padding-top: {{ section.settings.padding_top }}px;
    --fur-collection-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>

  <!-- =====================================================
       COLLECTION TOOLBAR
  ====================================================== -->

  <div class="fur-collection__toolbar">

    <!-- LEFT -->
    <div class="fur-collection__toolbar-left">

      <h1 class="fur-collection__title">
        [ {{ collection.title }} ]
      </h1>

    </div>


    <!-- CENTER -->
    <div class="fur-collection__toolbar-center">

      {% if section.settings.show_product_count %}

        <span class="fur-collection__count">
          [ {{ collection.products_count }} - ITEMS ]
        </span>

      {% endif %}

    </div>


    <!-- RIGHT -->
    <div class="fur-collection__toolbar-right">


      <!-- ===============================================
           SIZE
      ================================================ -->

      {% if section.settings.show_size_filter %}

        <div class="fur-collection__size">

          <span class="fur-collection__control-label">
            SIZE +
          </span>

          <button
            type="button"
            class="fur-collection__pill"
            data-fur-size-toggle
          >
            ALL
          </button>

        </div>

      {% endif %}


      <!-- ===============================================
           SORT
      ================================================ -->

      {% if section.settings.show_sort %}

        {% assign current_sort = collection.sort_by | default: collection.default_sort_by %}

        <div
          class="fur-collection__sort"
          data-fur-sort
        >

          <button
            type="button"
            class="fur-collection__sort-toggle"
            aria-expanded="false"
            aria-controls="fur-sort-menu-{{ section.id }}"
            data-fur-sort-toggle
          >

            <span>
              SORT BY +
            </span>


            <span class="fur-collection__pill">

              {% case current_sort %}

                {% when 'price-ascending' %}
                  PRICE: LOW TO HIGH

                {% when 'price-descending' %}
                  PRICE: HIGH TO LOW

                {% when 'created-descending' %}
                  NEWEST

                {% when 'created-ascending' %}
                  OLDEST

                {% when 'title-ascending' %}
                  A-Z

                {% when 'title-descending' %}
                  Z-A

                {% when 'best-selling' %}
                  BEST SELLER

                {% else %}
                  BEST SELLER

              {% endcase %}

            </span>

          </button>


          <div
            id="fur-sort-menu-{{ section.id }}"
            class="fur-collection__sort-menu"
            data-fur-sort-menu
            hidden
          >

            <a
              href="{{ collection.url }}?sort_by=best-selling"
              class="
                fur-collection__sort-option
                {% if current_sort == 'best-selling' %}
                  is-active
                {% endif %}
              "
            >
              <span class="fur-collection__radio"></span>
              BEST SELLER
            </a>


            <a
              href="{{ collection.url }}?sort_by=price-ascending"
              class="
                fur-collection__sort-option
                {% if current_sort == 'price-ascending' %}
                  is-active
                {% endif %}
              "
            >
              <span class="fur-collection__radio"></span>
              PRICE: LOW TO HIGH
            </a>


            <a
              href="{{ collection.url }}?sort_by=price-descending"
              class="
                fur-collection__sort-option
                {% if current_sort == 'price-descending' %}
                  is-active
                {% endif %}
              "
            >
              <span class="fur-collection__radio"></span>
              PRICE: HIGH TO LOW
            </a>


            <a
              href="{{ collection.url }}?sort_by=created-descending"
              class="
                fur-collection__sort-option
                {% if current_sort == 'created-descending' %}
                  is-active
                {% endif %}
              "
            >
              <span class="fur-collection__radio"></span>
              NEWEST
            </a>


            <a
              href="{{ collection.url }}?sort_by=created-ascending"
              class="
                fur-collection__sort-option
                {% if current_sort == 'created-ascending' %}
                  is-active
                {% endif %}
              "
            >
              <span class="fur-collection__radio"></span>
              OLDEST
            </a>


            <a
              href="{{ collection.url }}?sort_by=title-ascending"
              class="
                fur-collection__sort-option
                {% if current_sort == 'title-ascending' %}
                  is-active
                {% endif %}
              "
            >
              <span class="fur-collection__radio"></span>
              A-Z
            </a>


            <a
              href="{{ collection.url }}?sort_by=title-descending"
              class="
                fur-collection__sort-option
                {% if current_sort == 'title-descending' %}
                  is-active
                {% endif %}
              "
            >
              <span class="fur-collection__radio"></span>
              Z-A
            </a>

          </div>

        </div>

      {% endif %}


      <!-- ===============================================
           GRID VIEW
      ================================================ -->

      {% if section.settings.show_grid_controls %}

        <div class="fur-collection__view-controls">

          <button
            type="button"
            class="fur-collection__view-button"
            data-fur-view="editorial"
            aria-label="Editorial view"
          >
            ▯
          </button>


          <button
            type="button"
            class="fur-collection__view-button is-active"
            data-fur-view="standard"
            aria-label="Standard grid view"
          >
            ▥
          </button>


          <button
            type="button"
            class="fur-collection__view-button"
            data-fur-view="compact"
            aria-label="Compact grid view"
          >
            ▦
          </button>

        </div>

      {% endif %}

    </div>

  </div>


  <!-- =====================================================
       DESCRIPTION
  ====================================================== -->

  {% if section.settings.show_description and collection.description != blank %}

    <div class="fur-collection__description">
      {{ collection.description }}
    </div>

  {% endif %}


  <!-- =====================================================
       PRODUCTS
  ====================================================== -->

  {% paginate collection.products by section.settings.products_per_page %}

    {% if collection.products.size > 0 %}

      <div
        class="
          fur-collection__grid
          fur-collection__grid--standard
        "
        data-fur-product-grid
        data-fur-view-mode="standard"
      >

        {% for product in collection.products %}

        {% render 'fur-product-card',
          product: product,
          image_ratio: section.settings.image_ratio,
          image_hover_animation: section.settings.image_hover_animation,
          show_compare_price: section.settings.show_compare_price,
          show_badges: section.settings.show_badges,
          badge_tag: section.settings.badge_tag,
          custom_badge: section.settings.custom_badge,
          sale_badge: section.settings.sale_badge,
          sold_out_badge: section.settings.sold_out_badge,
          option_name: section.settings.option_name,
          hover_fallback_text: section.settings.hover_fallback_text
        %}

        {% endfor %}

      </div>


    {% else %}

      <div class="fur-collection__empty">
        NO PRODUCTS FOUND
      </div>

    {% endif %}


    <!-- ===================================================
         PAGINATION
    ==================================================== -->

    {% if paginate.pages > 1 %}

      <nav
        class="fur-collection__pagination"
        role="navigation"
        aria-label="Pagination"
      >

        <div class="fur-collection__pagination-side">

          {% if paginate.previous %}

            <a
              href="{{ paginate.previous.url }}"
              class="fur-collection__pagination-link"
            >
              PREV
            </a>

          {% endif %}

        </div>


        <div class="fur-collection__pagination-pages">

          {% for part in paginate.parts %}

            {% if part.is_link %}

              <a
                href="{{ part.url }}"
                class="fur-collection__pagination-link"
              >
                {{ part.title }}
              </a>

            {% else %}

              <span
                class="
                  fur-collection__pagination-link
                  {% if part.title == paginate.current_page %}
                    is-current
                  {% endif %}
                "
              >
                {{ part.title }}
              </span>

            {% endif %}

          {% endfor %}

        </div>


        <div class="fur-collection__pagination-side fur-collection__pagination-side--right">

          {% if paginate.next %}

            <a
              href="{{ paginate.next.url }}"
              class="fur-collection__pagination-link"
            >
              NEXT
            </a>

          {% endif %}

        </div>

      </nav>

    {% endif %}

  {% endpaginate %}

</section>


{% schema %}
{
  "name": "Fur main collection",

  "settings": [

    {
      "type": "header",
      "content": "Collection toolbar"
    },
    {
  "type": "select",
  "id": "image_hover_animation",
  "label": "Image hover animation",
  "options": [
    {
      "value": "compress",
      "label": "Hero compression"
    },
    {
      "value": "slide",
      "label": "Slide"
    }
  ],
  "default": "compress"
},

    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_size_filter",
      "label": "Show size control",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show sort",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_grid_controls",
      "label": "Show grid controls",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": false
    },


    {
      "type": "header",
      "content": "Product grid"
    },

    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Products per page",
      "default": 24
    },

    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Desktop columns",
      "default": 4
    },

    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },

    {
      "type": "range",
      "id": "grid_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Grid gap",
      "default": 8
    },


    {
      "type": "header",
      "content": "Product cards"
    },

    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "adapt"
    },

    {
      "type": "text",
      "id": "option_name",
      "label": "Option name to show on hover",
      "default": "Size",
      "info": "Use the exact product option name, such as Size."
    },

    {
      "type": "text",
      "id": "hover_fallback_text",
      "label": "Fallback hover text",
      "default": "VIEW PRODUCT"
    },

    {
      "type": "checkbox",
      "id": "show_compare_price",
      "label": "Show compare price",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show badges",
      "default": true
    },


    {
      "type": "header",
      "content": "Product badges"
    },

    {
      "type": "text",
      "id": "badge_tag",
      "label": "Custom badge product tag",
      "default": "Best Seller"
    },

    {
      "type": "text",
      "id": "custom_badge",
      "label": "Custom badge text",
      "default": "BEST SELLER"
    },

    {
      "type": "text",
      "id": "sale_badge",
      "label": "Sale badge text",
      "default": "SALE"
    },

    {
      "type": "text",
      "id": "sold_out_badge",
      "label": "Sold out badge text",
      "default": "SOLD OUT"
    },


    {
      "type": "header",
      "content": "Spacing"
    },

    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 8
    },

    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 20
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }

  ],

  "presets": [
    {
      "name": "Fur main collection"
    }
  ]
}
{% endschema %}