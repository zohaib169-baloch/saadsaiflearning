{{ 'fur-footer.css' | asset_url | stylesheet_tag }}

<script
  src="{{ 'fur-footer.js' | asset_url }}"
  defer
></script>

<footer
  id="FurFooter-{{ section.id }}"
  class="fur-footer"
  data-fur-footer

  style="
    --fur-footer-text: {{ section.settings.text_color }};
    --fur-footer-accent: {{ section.settings.accent_color }};
    --fur-footer-background: {{ section.settings.background_color }};

    --fur-footer-height: {{ section.settings.desktop_height }}px;
    --fur-footer-padding-x: {{ section.settings.desktop_padding }}px;

    --fur-footer-nav-size: {{ section.settings.nav_font_size }}px;
    --fur-footer-brand-size: {{ section.settings.brand_font_size }}px;
    --fur-footer-subscribe-size: {{ section.settings.subscribe_font_size }}px;
  "
>


  <!-- =====================================================
       BACKGROUND
  ====================================================== -->

  <picture class="fur-footer__background">

    {% if section.settings.mobile_background_image != blank %}

      <source
        media="(max-width: 749px)"
        srcset="
          {{ section.settings.mobile_background_image | image_url: width: 600 }} 600w,
          {{ section.settings.mobile_background_image | image_url: width: 900 }} 900w,
          {{ section.settings.mobile_background_image | image_url: width: 1200 }} 1200w
        "
      >

    {% endif %}


    {% if section.settings.desktop_background_image != blank %}

      {{
        section.settings.desktop_background_image
        | image_url: width: 2400
        | image_tag:
          class: 'fur-footer__background-image',
          loading: 'lazy',
          widths: '900, 1200, 1600, 1920, 2200, 2400',
          alt: ''
      }}

    {% elsif section.settings.mobile_background_image != blank %}

      {{
        section.settings.mobile_background_image
        | image_url: width: 1600
        | image_tag:
          class: 'fur-footer__background-image',
          loading: 'lazy',
          widths: '600, 900, 1200, 1600',
          alt: ''
      }}

    {% endif %}

  </picture>


  <!-- Optional tint -->
  <div
    class="fur-footer__overlay"
    aria-hidden="true"
    style="
      --fur-footer-overlay-opacity:
        {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    "
  ></div>


  <!-- =====================================================
       CONTENT
  ====================================================== -->

  <div class="fur-footer__inner">


    <!-- ===================================================
         TOP NAVIGATION
    ==================================================== -->

    <div class="fur-footer__top">


      <!-- LEFT MENU -->

      <nav
        class="fur-footer__nav fur-footer__nav--primary"
        aria-label="Footer navigation"
      >

        {% if section.settings.primary_menu != blank %}

          {% for link in section.settings.primary_menu.links %}

            <a
              href="{{ link.url }}"
              class="fur-footer__link"
              data-fur-stretch-link
            >
              {{ link.title }}
            </a>

          {% endfor %}

        {% endif %}


        {% if section.settings.small_label != blank %}

          <span class="fur-footer__small-label">
            {{ section.settings.small_label }}
          </span>

        {% endif %}

      </nav>


      <!-- RIGHT MENU -->

      <nav
        class="fur-footer__nav fur-footer__nav--utility"
        aria-label="Footer information"
      >

        {% if section.settings.utility_menu != blank %}

          {% for link in section.settings.utility_menu.links %}

            <a
              href="{{ link.url }}"
              class="fur-footer__link"
              data-fur-stretch-link
            >
              {{ link.title }}
            </a>

          {% endfor %}

        {% endif %}

      </nav>

    </div>


    <!-- ===================================================
         DISCOUNT BADGE
    ==================================================== -->

{% if section.settings.show_discount_badge %}

  <button
    type="button"
    class="fur-footer__discount"
    data-fur-footer-discount
    aria-expanded="false"
  >

    <span class="fur-footer__discount-text">

      <span class="fur-footer__discount-label">
        {{ section.settings.discount_label }}
      </span>

      <span class="fur-footer__discount-percentage">
        {{ section.settings.discount_percentage }}
      </span>

    </span>

  </button>

{% endif %}


    <!-- ===================================================
         LARGE BRAND
    ==================================================== -->

    {% if section.settings.brand_text != blank %}

      <div class="fur-footer__brand">
        {{ section.settings.brand_text }}
      </div>

    {% endif %}


    <!-- ===================================================
         NEWSLETTER
    ==================================================== -->

    <div class="fur-footer__newsletter">


      <div class="fur-footer__newsletter-heading">

        <span class="fur-footer__subscribe-title">
          {{ section.settings.subscribe_heading }}
        </span>


        {% if section.settings.subscribe_subheading != blank %}

          <span class="fur-footer__subscribe-subtitle">
            (
            {{ section.settings.subscribe_subheading }}
            )
          </span>

        {% endif %}

      </div>


{% assign fur_footer_form_id = 'FurFooterNewsletter-' | append: section.id %}

{% form 'customer',
  id: fur_footer_form_id,
  class: 'fur-footer__newsletter-form'
%}

        <input
          type="hidden"
          name="contact[tags]"
          value="newsletter"
        >


        <div
          class="fur-footer__email-row"
          data-fur-email-row
        >

          <div class="fur-footer__email-field">

            <label
              for="FurFooterEmail-{{ section.id }}"
              class="fur-footer__email-label"
            >
              EMAIL
            </label>

            <input
              id="FurFooterEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              value="{% if customer %}{{ customer.email }}{% endif %}"
              class="fur-footer__email-input"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              required
              data-fur-footer-email
            >

          </div>


          <button
            type="submit"
            class="fur-footer__subscribe-button"
            data-fur-stretch-link
          >
            {{ section.settings.subscribe_button }}
          </button>

        </div>


        {% if form.posted_successfully? %}

          <div class="fur-footer__message">
            {{ section.settings.success_message }}
          </div>

        {% endif %}


        {% if form.errors %}

          <div class="fur-footer__message fur-footer__message--error">
            {{ form.errors | default_errors }}
          </div>

        {% endif %}

      {% endform %}

    </div>


    <!-- ===================================================
         BOTTOM
    ==================================================== -->

    <div class="fur-footer__bottom">


      <!-- COPYRIGHT -->

      <div class="fur-footer__copyright">
        {{ section.settings.copyright_text }}
      </div>


      <!-- BOTTOM MENU -->

      <nav
        class="fur-footer__bottom-links"
        aria-label="Footer legal links"
      >

        {% if section.settings.bottom_menu != blank %}

          {% for link in section.settings.bottom_menu.links %}

            <a
              href="{{ link.url }}"
              class="fur-footer__link"
              data-fur-stretch-link
            >
              {{ link.title }}
            </a>

          {% endfor %}

        {% endif %}

      </nav>


      <!-- SOCIAL -->

      {% if section.settings.social_label != blank %}

        <a
          href="{{ section.settings.social_url | default: '#' }}"
          class="fur-footer__social"
          data-fur-stretch-link
        >
          {{ section.settings.social_label }}
        </a>

      {% endif %}

    </div>

  </div>

</footer>


{% schema %}
{
  "name": "Fur footer",

  "settings": [

    {
      "type": "header",
      "content": "Background images"
    },

    {
      "type": "image_picker",
      "id": "desktop_background_image",
      "label": "Desktop background image"
    },

    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Mobile background image"
    },

    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Image overlay",
      "default": 0
    },


    {
      "type": "header",
      "content": "Navigation"
    },

    {
      "type": "link_list",
      "id": "primary_menu",
      "label": "Left menu"
    },

    {
      "type": "link_list",
      "id": "utility_menu",
      "label": "Right menu"
    },

    {
      "type": "link_list",
      "id": "bottom_menu",
      "label": "Bottom menu"
    },

    {
      "type": "text",
      "id": "small_label",
      "label": "Small menu label",
      "default": "5-HIT"
    },


    {
      "type": "header",
      "content": "Discount"
    },

    {
      "type": "checkbox",
      "id": "show_discount_badge",
      "label": "Show discount badge",
      "default": true
    },

    {
      "type": "text",
      "id": "discount_label",
      "label": "Discount label",
      "default": "DISCOUNT"
    },

    {
      "type": "text",
      "id": "discount_percentage",
      "label": "Discount percentage",
      "default": "10%"
    },


    {
      "type": "header",
      "content": "Brand"
    },

    {
      "type": "text",
      "id": "brand_text",
      "label": "Large brand text",
      "default": "THE FUR"
    },


    {
      "type": "header",
      "content": "Newsletter"
    },

    {
      "type": "text",
      "id": "subscribe_heading",
      "label": "Heading",
      "default": "SUBSCRIBE"
    },

    {
      "type": "text",
      "id": "subscribe_subheading",
      "label": "Heading small text",
      "default": "LATEST NEWS"
    },

    {
      "type": "text",
      "id": "subscribe_button",
      "label": "Subscribe button",
      "default": "SUBSCRIBE"
    },

    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "THANK YOU FOR SUBSCRIBING"
    },


    {
      "type": "header",
      "content": "Bottom"
    },

    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright",
      "default": "©2026_THE FUR"
    },

    {
      "type": "text",
      "id": "social_label",
      "label": "Social label",
      "default": "IG"
    },

    {
      "type": "url",
      "id": "social_url",
      "label": "Social link"
    },


    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "range",
      "id": "desktop_height",
      "min": 450,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Desktop footer height",
      "default": 620
    },

    {
      "type": "range",
      "id": "desktop_padding",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Desktop horizontal padding",
      "default": 32
    },


    {
      "type": "header",
      "content": "Typography"
    },

    {
      "type": "range",
      "id": "nav_font_size",
      "min": 8,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Navigation font size",
      "default": 11
    },

    {
      "type": "range",
      "id": "brand_font_size",
      "min": 60,
      "max": 180,
      "step": 5,
      "unit": "px",
      "label": "Large brand font size",
      "default": 120
    },

    {
      "type": "range",
      "id": "subscribe_font_size",
      "min": 35,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Subscribe heading size",
      "default": 60
    },


    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Fallback background",
      "default": "#96908d"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },

    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#ff2e2e"
    }

  ],

  "presets": [
    {
      "name": "Fur footer"
    }
  ]
}
{% endschema %}