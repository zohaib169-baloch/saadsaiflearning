{% comment %}
  Editorial Collection Marquee

  Features:
  - Infinite seamless marquee
  - Play/pause button
  - Adjustable direction and speed
  - Horizontal image transition on card hover
  - One section-level custom cursor PNG
  - Custom cursor follows the mouse over collection cards
  - Vertical collection titles
{% endcomment %}

{%- liquid
  assign section_heading = section.settings.heading | default: 'CATEGORIES'
  assign has_custom_cursor = false

  if section.settings.cursor_image != blank
    assign has_custom_cursor = true
  endif
-%}

<section
  id="EditorialCollections-{{ section.id }}"
  class="editorial-collections{% if has_custom_cursor %} editorial-collections--custom-cursor{% endif %}"
  data-editorial-section
  data-autoplay="{{ section.settings.enable_autoplay }}"
  data-speed="{{ section.settings.marquee_speed }}"
  data-direction="{{ section.settings.marquee_direction }}"
  data-pause-hover="{{ section.settings.pause_on_hover }}"
  style="
    --section-background: {{ section.settings.background_color }};
    --card-background: {{ section.settings.card_background }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};

    --section-width: {{ section.settings.section_width }}px;
    --desktop-padding: {{ section.settings.desktop_padding }}px;
    --mobile-padding: {{ section.settings.mobile_padding }}px;

    --card-width: {{ section.settings.card_width }}px;
    --card-height: {{ section.settings.card_height }}px;
    --mobile-card-width: {{ section.settings.mobile_card_width }}px;
    --mobile-card-height: {{ section.settings.mobile_card_height }}px;
    --card-gap: {{ section.settings.card_gap }}px;

    --title-size: {{ section.settings.title_size }}px;
    --mobile-title-size: {{ section.settings.mobile_title_size }}px;
    --header-size: {{ section.settings.header_size }}px;
    --mobile-header-size: {{ section.settings.mobile_header_size }}px;

    --hover-duration: {{ section.settings.hover_duration | divided_by: 10.0 }}s;
    --cursor-size: {{ section.settings.cursor_size }}px;
  "
>
  {% if has_custom_cursor %}
    <div
      class="editorial-collections__custom-cursor"
      data-custom-cursor
      aria-hidden="true"
    >
      {{
        section.settings.cursor_image
        | image_url: width: 500
        | image_tag:
          class: 'editorial-collections__custom-cursor-image',
          loading: 'eager',
          alt: ''
      }}
    </div>
  {% endif %}

  <div class="editorial-collections__container">
    {% if section.settings.show_header %}
      <header class="editorial-collections__header">
        <div class="editorial-collections__heading-wrapper">
          {% if section.settings.section_number != blank %}
            <span class="editorial-collections__number">
              {{ section.settings.section_number }}
            </span>
          {% endif %}

          {% if section_heading != blank %}
            <h2 class="editorial-collections__heading">
              {{ section_heading }}
            </h2>
          {% endif %}
        </div>

        {% if section.settings.show_line %}
          <div class="editorial-collections__line" aria-hidden="true">
            <span class="editorial-collections__line-start"></span>
            <span class="editorial-collections__line-middle"></span>
            <span class="editorial-collections__line-end"></span>
          </div>
        {% endif %}

        <div class="editorial-collections__header-actions">
          {% if section.settings.show_autoplay_button %}
            <button
              type="button"
              class="editorial-collections__autoplay"
              data-editorial-autoplay
              aria-label="{% if section.settings.enable_autoplay %}Pause marquee{% else %}Play marquee{% endif %}"
              aria-pressed="{% if section.settings.enable_autoplay %}true{% else %}false{% endif %}"
            >
              <span
                class="editorial-collections__autoplay-icon"
                data-pause-icon
                {% unless section.settings.enable_autoplay %}
                  hidden
                {% endunless %}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="7" y="5" width="3" height="14" rx="1"></rect>
                  <rect x="14" y="5" width="3" height="14" rx="1"></rect>
                </svg>
              </span>

              <span
                class="editorial-collections__autoplay-icon"
                data-play-icon
                {% if section.settings.enable_autoplay %}
                  hidden
                {% endif %}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M8 5L19 12L8 19V5Z"></path>
                </svg>
              </span>

              {% if section.settings.show_autoplay_text %}
                <span data-autoplay-text>
                  {% if section.settings.enable_autoplay %}
                    Pause
                  {% else %}
                    Play
                  {% endif %}
                </span>
              {% endif %}
            </button>
          {% endif %}

          {% if section.settings.show_see_all %}
            <a
              href="{{ section.settings.see_all_link | default: routes.all_products_collection_url }}"
              class="editorial-collections__see-all"
            >
              {% if section.settings.show_brackets %}[{% endif %}
              {{ section.settings.see_all_text }}
              {% if section.settings.show_brackets %}]{% endif %}
            </a>
          {% endif %}
        </div>
      </header>
    {% endif %}

    <div class="editorial-collections__marquee-wrapper">
      {% if section.settings.show_arrows and section.blocks.size > 1 %}
        <button
          type="button"
          class="editorial-collections__arrow editorial-collections__arrow--previous"
          data-editorial-previous
          aria-label="Previous collections"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M15 18L9 12L15 6"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      {% endif %}

      <div
        class="editorial-collections__viewport"
        data-editorial-viewport
        role="region"
        aria-label="{{ section_heading | escape }}"
      >
        <div
          class="editorial-collections__track"
          data-editorial-track
          role="list"
        >
          {% for duplicate in (1..2) %}
            <div
              class="editorial-collections__group"
              data-editorial-group
              {% if duplicate == 2 %}
                aria-hidden="true"
              {% endif %}
            >
              {% for block in section.blocks %}
                {%- liquid
                  assign selected_collection = block.settings.collection

                  assign card_title = block.settings.custom_title
                  if card_title == blank and selected_collection != blank
                    assign card_title = selected_collection.title
                  endif
                  if card_title == blank
                    assign card_title = 'Collection'
                  endif

                  assign card_link = block.settings.custom_link
                  if card_link == blank and selected_collection != blank
                    assign card_link = selected_collection.url
                  endif
                  if card_link == blank
                    assign card_link = '#'
                  endif

                  assign image_1 = block.settings.image_1
                  if image_1 == blank and selected_collection != blank
                    assign image_1 = selected_collection.image
                  endif
                  if image_1 == blank and selected_collection != blank
                    assign image_1 = selected_collection.products.first.featured_image
                  endif

                  assign image_2 = block.settings.image_2
                  assign image_3 = block.settings.image_3

                  assign image_count = 1
                  if image_2 != blank
                    assign image_count = 2
                  endif
                  if image_3 != blank
                    assign image_count = 3
                  endif

                  assign displayed_count = block.settings.custom_count
                  if displayed_count == blank and selected_collection != blank
                    assign displayed_count = selected_collection.products_count
                  endif
                  if displayed_count == blank
                    assign displayed_count = forloop.index0
                  endif
                -%}

                <article
                  class="
                    editorial-card
                    editorial-card--{{ image_count }}-images
                    editorial-card--title-{{ block.settings.title_position }}
                  "
                  role="listitem"
                  {% if duplicate == 1 %}
                    {{ block.shopify_attributes }}
                  {% endif %}
                >
                  <a
                    href="{{ card_link }}"
                    class="editorial-card__link"
                    data-editorial-card-link
                    aria-label="{{ card_title | escape }}"
                    {% if duplicate == 2 %}
                      tabindex="-1"
                    {% endif %}
                  >
                    <div class="editorial-card__media">
                      <div class="editorial-card__image-track">
                        <div class="editorial-card__slide">
                          {% if image_1 != blank %}
                            {{
                              image_1
                              | image_url: width: 1200
                              | image_tag:
                                class: 'editorial-card__image',
                                loading: 'lazy',
                                widths: '300, 450, 600, 800, 1000, 1200',
                                sizes: '(min-width: 750px) 340px, 80vw',
                                alt: card_title
                            }}
                          {% else %}
                            {{
                              'collection-1'
                              | placeholder_svg_tag: 'editorial-card__placeholder'
                            }}
                          {% endif %}
                        </div>

                        {% if image_2 != blank %}
                          <div class="editorial-card__slide">
                            {{
                              image_2
                              | image_url: width: 1200
                              | image_tag:
                                class: 'editorial-card__image',
                                loading: 'lazy',
                                widths: '300, 450, 600, 800, 1000, 1200',
                                sizes: '(min-width: 750px) 340px, 80vw',
                                alt: card_title
                            }}
                          </div>
                        {% endif %}

                        {% if image_3 != blank %}
                          <div class="editorial-card__slide">
                            {{
                              image_3
                              | image_url: width: 1200
                              | image_tag:
                                class: 'editorial-card__image',
                                loading: 'lazy',
                                widths: '300, 450, 600, 800, 1000, 1200',
                                sizes: '(min-width: 750px) 340px, 80vw',
                                alt: card_title
                            }}
                          </div>
                        {% endif %}
                      </div>
                    </div>

                    {% if section.settings.show_titles %}
                      <div class="editorial-card__vertical-title">
                        <span>{{ card_title }}</span>
                      </div>
                    {% endif %}

                    {% if section.settings.show_count %}
                      <span class="editorial-card__count">
                        [{{ displayed_count }}]
                      </span>
                    {% endif %}
                  </a>
                </article>
              {% endfor %}
            </div>
          {% endfor %}
        </div>
      </div>

      {% if section.settings.show_arrows and section.blocks.size > 1 %}
        <button
          type="button"
          class="editorial-collections__arrow editorial-collections__arrow--next"
          data-editorial-next
          aria-label="Next collections"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M9 6L15 12L9 18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  #EditorialCollections-{{ section.id }} {
    width: 100%;
    overflow: hidden;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    color: var(--text-color);
    background: var(--section-background);
    font-family: Thunder, sans-serif;
  }

  #EditorialCollections-{{ section.id }} button,
  #EditorialCollections-{{ section.id }} a,
  #EditorialCollections-{{ section.id }} h2,
  #EditorialCollections-{{ section.id }} span {
    font-family: Thunder, sans-serif;
  }

  #EditorialCollections-{{ section.id }} *,
  #EditorialCollections-{{ section.id }} *::before,
  #EditorialCollections-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #EditorialCollections-{{ section.id }} .editorial-collections__container {
    width: min(100%, var(--section-width));
    margin-inline: auto;
    padding-inline: var(--desktop-padding);
  }

  /* Header */

  #EditorialCollections-{{ section.id }} .editorial-collections__header {
    display: grid;
    grid-template-columns: auto minmax(80px, 1fr) auto;
    align-items: center;
    gap: 24px;
    margin-bottom: {{ section.settings.header_spacing }}px;
  }

  #EditorialCollections-{{ section.id }} .editorial-collections__heading-wrapper {
    display: flex;
    align-items: baseline;
    gap: 5px;
    color: var(--accent-color);
    font-size: var(--header-size);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  #EditorialCollections-{{ section.id }} .editorial-collections__heading,
  #EditorialCollections-{{ section.id }} .editorial-collections__number {
    margin: 0;
    color: inherit;
    font: inherit;
  }

  #EditorialCollections-{{ section.id }} .editorial-collections__line {
    display: grid;
    grid-template-columns: 80px 1fr 24px;
    align-items: center;
    width: 100%;
  }

  #EditorialCollections-{{ section.id }} .editorial-collections__line-start,
  #EditorialCollections-{{ section.id }} .editorial-collections__line-end {
    display: block;
    height: 3px;
    background: var(--text-color);
  }

  #EditorialCollections-{{ section.id }} .editorial-collections__line-middle {
    display: block;
    height: 1px;
    background: rgba(0, 0, 0, 0.12);
  }

  #EditorialCollections-{{ section.id }} .editorial-collections__header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 14px;
  }

  #EditorialCollections-{{ section.id }} .editorial-collections__see-all {
    color: var(--text-color);
    font-size: var(--header-size);
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition: opacity 180ms ease;
  }

  #EditorialCollections-{{ section.id }} .editorial-collections__see-all:hover {
    opacity: 0.55;
  }

  /* Play / pause button */

  #EditorialCollections-{{ section.id }} .editorial-collections__autoplay {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 32px;
    padding: 6px 10px;
    border: 1px solid var(--text-color);
    border-radius: 0;
    color: var(--text-color);
    background: transparent;
    font: inherit;
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    cursor: pointer;
  }

  #EditorialCollections-{{ section.id }} .editorial-collections__autoplay-icon {
    display: flex;
    width: 15px;
    height: 15px;
  }

  #EditorialCollections-{{ section.id }} .editorial-collections__autoplay-icon[hidden] {
    display: none;
  }

  #EditorialCollections-{{ section.id }} .editorial-collections__autoplay-icon svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  /* Infinite marquee */

  #EditorialCollections-{{ section.id }} .editorial-collections__marquee-wrapper {
    position: relative;
  }

  #EditorialCollections-{{ section.id }} .editorial-collections__viewport {
    width: 100%;
    overflow: hidden;
    touch-action: pan-y;
  }

  #EditorialCollections-{{ section.id }} .editorial-collections__track {
    display: flex;
    align-items: stretch;
    width: max-content;
    min-width: 100%;
    will-change: transform;
  }

  #EditorialCollections-{{ section.id }} .editorial-collections__group {
    display: flex;
    flex: 0 0 auto;
    align-items: stretch;
    gap: var(--card-gap);
    padding-right: var(--card-gap);
  }

  /* Collection card */

  #EditorialCollections-{{ section.id }} .editorial-card {
    position: relative;
    flex: 0 0 var(--card-width);
    width: var(--card-width);
    height: var(--card-height);
    overflow: hidden;
    background: var(--card-background);
    isolation: isolate;
  }

  #EditorialCollections-{{ section.id }} .editorial-card__link {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    color: var(--text-color);
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    #EditorialCollections-{{ section.id }}.editorial-collections--custom-cursor
    .editorial-card__link {
      cursor: none;
    }
  }

  /* Card image transition */

  #EditorialCollections-{{ section.id }} .editorial-card__media {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    background: var(--card-background);
  }

  #EditorialCollections-{{ section.id }} .editorial-card__image-track {
    display: flex;
    width: 100%;
    height: 100%;
    transform: translate3d(0, 0, 0);
    transition:
      transform var(--hover-duration)
      cubic-bezier(0.76, 0, 0.24, 1);
    will-change: transform;
  }

  #EditorialCollections-{{ section.id }}
  .editorial-card--2-images
  .editorial-card__image-track {
    width: 200%;
  }

  #EditorialCollections-{{ section.id }}
  .editorial-card--3-images
  .editorial-card__image-track {
    width: 300%;
  }

  #EditorialCollections-{{ section.id }} .editorial-card__slide {
    position: relative;
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--card-background);
  }

  #EditorialCollections-{{ section.id }}
  .editorial-card--2-images
  .editorial-card__slide {
    flex-basis: 50%;
    width: 50%;
  }

  #EditorialCollections-{{ section.id }}
  .editorial-card--3-images
  .editorial-card__slide {
    flex-basis: 33.333333%;
    width: 33.333333%;
  }

  #EditorialCollections-{{ section.id }} .editorial-card__image {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: {{ section.settings.image_fit }};
    object-position: {{ section.settings.image_position }};
  }

  #EditorialCollections-{{ section.id }} .editorial-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (hover: hover) and (pointer: fine) {
    #EditorialCollections-{{ section.id }}
    .editorial-card--2-images:hover
    .editorial-card__image-track,
    #EditorialCollections-{{ section.id }}
    .editorial-card--2-images:focus-within
    .editorial-card__image-track {
      transform: translate3d(-50%, 0, 0);
    }

    #EditorialCollections-{{ section.id }}
    .editorial-card--3-images:hover
    .editorial-card__image-track,
    #EditorialCollections-{{ section.id }}
    .editorial-card--3-images:focus-within
    .editorial-card__image-track {
      transform: translate3d(-66.666667%, 0, 0);
    }
  }

  /* Vertical title */

  #EditorialCollections-{{ section.id }} .editorial-card__vertical-title {
    position: absolute;
    z-index: 5;
    bottom: {{ section.settings.title_offset }}px;
    pointer-events: none;
  }

  #EditorialCollections-{{ section.id }}
  .editorial-card--title-left
  .editorial-card__vertical-title {
    left: {{ section.settings.title_offset }}px;
  }

  #EditorialCollections-{{ section.id }}
  .editorial-card--title-right
  .editorial-card__vertical-title {
    right: {{ section.settings.title_offset }}px;
  }

  #EditorialCollections-{{ section.id }} .editorial-card__vertical-title span {
    display: block;
    color: var(--text-color);
    font-size: var(--title-size);
    font-weight: {{ section.settings.title_weight }};
    line-height: 0.82;
    letter-spacing: {{ section.settings.title_letter_spacing | divided_by: 100.0 }}em;
    text-transform: uppercase;
    white-space: nowrap;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  #EditorialCollections-{{ section.id }}
  .editorial-card--title-right
  .editorial-card__vertical-title span {
    transform: none;
  }

  /* Count */

  #EditorialCollections-{{ section.id }} .editorial-card__count {
    position: absolute;
    z-index: 5;
    right: {{ section.settings.count_offset }}px;
    bottom: {{ section.settings.count_offset }}px;
    color: var(--text-color);
    font-size: {{ section.settings.count_size }}px;
    font-weight: 600;
    line-height: 1;
    pointer-events: none;
  }

  #EditorialCollections-{{ section.id }}
  .editorial-card--title-right
  .editorial-card__count {
    right: auto;
    left: {{ section.settings.count_offset }}px;
  }

  /* Section-level mouse-following cursor */

  #EditorialCollections-{{ section.id }} .editorial-collections__custom-cursor {
    position: fixed;
    z-index: 999999;
    top: 0;
    left: 0;
    display: none;
    width: var(--cursor-size);
    height: auto;
    opacity: 0;
    pointer-events: none;
    transform: translate3d(-50%, -50%, 0) scale(0.75);
    transition:
      opacity 150ms ease,
      transform 180ms ease;
    will-change: left, top, transform;
  }

  #EditorialCollections-{{ section.id }} .editorial-collections__custom-cursor.is-visible {
    display: block;
    opacity: 1;
    transform: translate3d(-50%, -50%, 0) scale(1);
  }

  #EditorialCollections-{{ section.id }} .editorial-collections__custom-cursor-image {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Arrows */

  #EditorialCollections-{{ section.id }} .editorial-collections__arrow {
    position: absolute;
    z-index: 10;
    top: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.arrow_size }}px;
    height: {{ section.settings.arrow_size }}px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: {{ section.settings.arrow_color }};
    background: {{ section.settings.arrow_background }};
    box-shadow: 0 5px 18px rgba(0, 0, 0, 0.12);
    cursor: pointer;
    transform: translateY(-50%);
  }

  #EditorialCollections-{{ section.id }} .editorial-collections__arrow svg {
    width: 22px;
    height: 22px;
  }

  #EditorialCollections-{{ section.id }} .editorial-collections__arrow--previous {
    left: 10px;
  }

  #EditorialCollections-{{ section.id }} .editorial-collections__arrow--next {
    right: 10px;
  }

  @media screen and (max-width: 749px) {
    #EditorialCollections-{{ section.id }} .editorial-collections__container {
      padding-inline: var(--mobile-padding);
    }

    #EditorialCollections-{{ section.id }} .editorial-collections__header {
      grid-template-columns: 1fr auto;
      gap: 12px;
    }

    #EditorialCollections-{{ section.id }} .editorial-collections__heading-wrapper,
    #EditorialCollections-{{ section.id }} .editorial-collections__see-all {
      font-size: var(--mobile-header-size);
    }

    #EditorialCollections-{{ section.id }} .editorial-collections__line {
      display: none;
    }

    #EditorialCollections-{{ section.id }} .editorial-card {
      flex-basis: var(--mobile-card-width);
      width: var(--mobile-card-width);
      height: var(--mobile-card-height);
    }

    #EditorialCollections-{{ section.id }} .editorial-card__vertical-title span {
      font-size: var(--mobile-title-size);
    }

    #EditorialCollections-{{ section.id }} .editorial-collections__arrow {
      {% if section.settings.show_mobile_arrows %}
        display: flex;
      {% else %}
        display: none;
      {% endif %}
    }

    #EditorialCollections-{{ section.id }} .editorial-collections__custom-cursor {
      display: none !important;
    }
  }
{% endstyle %}

<script>
  (() => {
    const sectionId = 'EditorialCollections-{{ section.id }}';

    function initializeEditorialMarquee() {
      const section = document.getElementById(sectionId);

      if (!section || section.dataset.initialized === 'true') {
        return;
      }

      section.dataset.initialized = 'true';

      const viewport = section.querySelector('[data-editorial-viewport]');
      const track = section.querySelector('[data-editorial-track]');
      const firstGroup = section.querySelector('[data-editorial-group]');
      const autoplayButton = section.querySelector('[data-editorial-autoplay]');
      const playIcon = section.querySelector('[data-play-icon]');
      const pauseIcon = section.querySelector('[data-pause-icon]');
      const autoplayText = section.querySelector('[data-autoplay-text]');
      const previousButton = section.querySelector('[data-editorial-previous]');
      const nextButton = section.querySelector('[data-editorial-next]');
      const customCursor = section.querySelector('[data-custom-cursor]');
      const cardLinks = section.querySelectorAll('[data-editorial-card-link]');

      if (!viewport || !track || !firstGroup) {
        return;
      }

      let autoplayEnabled = section.dataset.autoplay === 'true';
      let temporarilyPaused = false;
      let animationFrame = null;
      let lastTimestamp = null;
      let position = 0;

      const speed = Math.max(5, Number(section.dataset.speed) || 30);
      const direction = section.dataset.direction === 'right' ? 1 : -1;
      const pauseOnHover = section.dataset.pauseHover === 'true';

      function getLoopWidth() {
        return firstGroup.getBoundingClientRect().width;
      }

      function normalizePosition() {
        const loopWidth = getLoopWidth();

        if (!loopWidth) {
          return;
        }

        while (position <= -loopWidth) {
          position += loopWidth;
        }

        while (position >= 0) {
          position -= loopWidth;
        }
      }

      function applyTransform() {
        track.style.transform = `translate3d(${position}px, 0, 0)`;
      }

      function animate(timestamp) {
        if (lastTimestamp === null) {
          lastTimestamp = timestamp;
        }

        const elapsed = Math.min(50, timestamp - lastTimestamp);
        lastTimestamp = timestamp;

        if (autoplayEnabled && !temporarilyPaused) {
          position += direction * speed * (elapsed / 1000);
          normalizePosition();
          applyTransform();
        }

        animationFrame = window.requestAnimationFrame(animate);
      }

      function updateAutoplayButton() {
        if (!autoplayButton) {
          return;
        }

        autoplayButton.setAttribute(
          'aria-label',
          autoplayEnabled ? 'Pause marquee' : 'Play marquee'
        );

        autoplayButton.setAttribute(
          'aria-pressed',
          autoplayEnabled ? 'true' : 'false'
        );

        if (playIcon) {
          playIcon.hidden = autoplayEnabled;
        }

        if (pauseIcon) {
          pauseIcon.hidden = !autoplayEnabled;
        }

        if (autoplayText) {
          autoplayText.textContent = autoplayEnabled ? 'Pause' : 'Play';
        }
      }

      function moveByCard(multiplier) {
        const card = section.querySelector('.editorial-card');

        if (!card) {
          return;
        }

        const styles = window.getComputedStyle(firstGroup);
        const gap = parseFloat(styles.gap || styles.columnGap) || 0;
        const distance = card.getBoundingClientRect().width + gap;

        position += distance * multiplier;
        normalizePosition();

        track.style.transition =
          'transform 450ms cubic-bezier(0.22, 1, 0.36, 1)';

        applyTransform();

        window.setTimeout(() => {
          track.style.transition = '';
          lastTimestamp = null;
        }, 470);
      }

      autoplayButton?.addEventListener('click', () => {
        autoplayEnabled = !autoplayEnabled;
        lastTimestamp = null;
        updateAutoplayButton();
      });

      previousButton?.addEventListener('click', () => {
        moveByCard(1);
      });

      nextButton?.addEventListener('click', () => {
        moveByCard(-1);
      });

      if (pauseOnHover) {
        viewport.addEventListener('mouseenter', () => {
          temporarilyPaused = true;
        });

        viewport.addEventListener('mouseleave', () => {
          temporarilyPaused = false;
          lastTimestamp = null;
        });
      }

      if (customCursor && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        cardLinks.forEach((cardLink) => {
          cardLink.addEventListener('pointerenter', (event) => {
            customCursor.classList.add('is-visible');
            customCursor.style.left = `${event.clientX}px`;
            customCursor.style.top = `${event.clientY}px`;
          });

          cardLink.addEventListener('pointermove', (event) => {
            customCursor.style.left = `${event.clientX}px`;
            customCursor.style.top = `${event.clientY}px`;
          });

          cardLink.addEventListener('pointerleave', () => {
            customCursor.classList.remove('is-visible');
          });
        });

        window.addEventListener('blur', () => {
          customCursor.classList.remove('is-visible');
        });
      }

      document.addEventListener('visibilitychange', () => {
        temporarilyPaused = document.hidden;
        lastTimestamp = null;

        if (document.hidden && customCursor) {
          customCursor.classList.remove('is-visible');
        }
      });

      window.addEventListener('resize', () => {
        normalizePosition();
        applyTransform();
      });

      const loopWidth = getLoopWidth();

      if (direction === 1 && loopWidth) {
        position = -loopWidth;
      }

      applyTransform();
      updateAutoplayButton();

      animationFrame = window.requestAnimationFrame(animate);

      section.addEventListener('editorial:destroy', () => {
        if (animationFrame) {
          window.cancelAnimationFrame(animationFrame);
        }
      });
    }

    initializeEditorialMarquee();

    document.addEventListener('shopify:section:load', (event) => {
      if (event.detail.sectionId === '{{ section.id }}') {
        const section = document.getElementById(sectionId);

        if (section) {
          section.dataset.initialized = 'false';
        }

        initializeEditorialMarquee();
      }
    });

    document.addEventListener('shopify:section:unload', (event) => {
      if (event.detail.sectionId === '{{ section.id }}') {
        document
          .getElementById(sectionId)
          ?.dispatchEvent(new CustomEvent('editorial:destroy'));
      }
    });
  })();
</script>

