{{ 'hero-banner.css' | asset_url | stylesheet_tag }}

<script
  src="{{ 'hero-banner.js' | asset_url }}"
  defer
></script>

<section
  id="HeroBanner-{{ section.id }}"
  class="
    hero-banner
    hero-banner--desktop-{{ section.settings.desktop_image_fit }}
    hero-banner--mobile-{{ section.settings.mobile_image_fit }}
  "
  data-hero-banner
  data-autoplay="{{ section.settings.autoplay }}"
  data-slide-duration="{{ section.settings.slide_duration }}"
  data-transition-duration="{{ section.settings.transition_duration }}"
  style="
    --hero-desktop-height: {{ section.settings.desktop_height }}vh;
    --hero-mobile-height: {{ section.settings.mobile_height }}vh;

    --hero-left-size-desktop: {{ section.settings.left_text_size_desktop }}px;
    --hero-right-size-desktop: {{ section.settings.right_text_size_desktop }}px;

    --hero-left-size-mobile: {{ section.settings.left_text_size_mobile }}px;
    --hero-right-size-mobile: {{ section.settings.right_text_size_mobile }}px;

    --hero-background: {{ section.settings.background_color }};
  "
>

  <div class="hero-banner__viewport">

    <div
      class="hero-banner__slides"
      data-hero-slides
    >

      {% assign slide_index = 0 %}

      {% for block in section.blocks %}

        {% if block.type == 'slide' %}

          {% liquid
            assign desktop_image = block.settings.desktop_image
            assign mobile_image = block.settings.mobile_image

            assign desktop_ratio = 1.7778
            assign mobile_ratio = 0.75

            if desktop_image != blank
              assign desktop_ratio = desktop_image.aspect_ratio
            endif

            if mobile_image != blank
              assign mobile_ratio = mobile_image.aspect_ratio
            elsif desktop_image != blank
              assign mobile_ratio = desktop_image.aspect_ratio
            endif
          %}

          <article
            class="
              hero-banner__slide
              {% if slide_index == 0 %}
                is-active
              {% endif %}
            "
            data-hero-slide
            data-slide-index="{{ slide_index }}"
            {{ block.shopify_attributes }}
            style="
              --hero-desktop-ratio: {{ desktop_ratio }};
              --hero-mobile-ratio: {{ mobile_ratio }};
              --hero-slide-text: {{ block.settings.text_color }};
              --hero-slide-accent: {{ block.settings.accent_color }};
            "
          >

            <!-- =========================================
                 MEDIA
            ========================================== -->

            <div class="hero-banner__media">

              <picture class="hero-banner__picture">

                {% if mobile_image != blank %}

                  <source
                    media="(max-width: 749px)"
                    srcset="
                      {{ mobile_image | image_url: width: 400 }} 400w,
                      {{ mobile_image | image_url: width: 600 }} 600w,
                      {{ mobile_image | image_url: width: 800 }} 800w,
                      {{ mobile_image | image_url: width: 1000 }} 1000w,
                      {{ mobile_image | image_url: width: 1200 }} 1200w
                    "
                    sizes="100vw"
                  >

                {% endif %}


                {% if desktop_image != blank %}

                  {{
                    desktop_image
                    | image_url: width: 2600
                    | image_tag:
                      class: 'hero-banner__image',
                      loading: 'eager',
                      widths: '800, 1200, 1600, 1920, 2200, 2600',
                      sizes: '100vw',
                      alt: block.settings.image_alt
                  }}

                {% elsif mobile_image != blank %}

                  {{
                    mobile_image
                    | image_url: width: 1600
                    | image_tag:
                      class: 'hero-banner__image',
                      loading: 'eager',
                      widths: '400, 600, 800, 1000, 1200, 1600',
                      sizes: '100vw',
                      alt: block.settings.image_alt
                  }}

                {% else %}

                  {{
                    'lifestyle-1'
                    | placeholder_svg_tag:
                      'hero-banner__placeholder'
                  }}

                {% endif %}

              </picture>

            </div>


            <!-- =========================================
                 CONTENT
            ========================================== -->

            <div class="hero-banner__content">

              {% if block.settings.left_heading != blank %}

                <div
                  class="
                    hero-banner__heading
                    hero-banner__heading--left
                  "
                >
                  {{ block.settings.left_heading }}
                </div>

              {% endif %}


              {% if block.settings.right_heading != blank %}

                <div
                  class="
                    hero-banner__heading
                    hero-banner__heading--right
                  "
                >
                  {{ block.settings.right_heading }}
                </div>

              {% endif %}


              {% if block.settings.link_label != blank %}

                {% if block.settings.link != blank %}

                  <a
                    href="{{ block.settings.link }}"
                    class="hero-banner__collection-link"
                  >
                    [{{ block.settings.link_label }}]
                  </a>

                {% else %}

                  <span class="hero-banner__collection-link">
                    [{{ block.settings.link_label }}]
                  </span>

                {% endif %}

              {% endif %}


              {% if block.settings.bottom_heading != blank %}

                <div class="hero-banner__bottom-heading">
                  {{ block.settings.bottom_heading }}
                </div>

              {% endif %}


              {% if block.settings.small_label != blank %}

                <div class="hero-banner__small-label">
                  {{ block.settings.small_label }}
                </div>

              {% endif %}

            </div>

          </article>

          {% assign slide_index = slide_index | plus: 1 %}

        {% endif %}

      {% endfor %}


      {% if slide_index == 0 %}

        <div class="hero-banner__empty">
          Add a slide to the Hero banner.
        </div>

      {% endif %}

    </div>


    <!-- =========================================
         CONTROLS
    ========================================== -->

    {% if section.blocks.size > 1 and section.settings.show_controls %}

      <div
        class="hero-banner__controls"
        data-hero-controls
      >

        <button
          type="button"
          class="
            hero-banner__arrow
            hero-banner__arrow--prev
          "
          data-hero-prev
          aria-label="Previous slide"
        >
          ←
        </button>


        {% if section.settings.show_dots %}

          <div
            class="hero-banner__pagination"
            data-hero-pagination
          >

            {% assign dot_index = 0 %}

            {% for block in section.blocks %}

              {% if block.type == 'slide' %}

                <button
                  type="button"
                  class="
                    hero-banner__dot
                    {% if dot_index == 0 %}
                      is-active
                    {% endif %}
                  "
                  data-hero-dot
                  data-index="{{ dot_index }}"
                  aria-label="Go to slide {{ dot_index | plus: 1 }}"
                  {% if dot_index == 0 %}
                    aria-current="true"
                  {% else %}
                    aria-current="false"
                  {% endif %}
                ></button>

                {% assign dot_index = dot_index | plus: 1 %}

              {% endif %}

            {% endfor %}

          </div>

        {% endif %}


        <button
          type="button"
          class="
            hero-banner__arrow
            hero-banner__arrow--next
          "
          data-hero-next
          aria-label="Next slide"
        >
          →
        </button>

      </div>

    {% endif %}

  </div>

</section>


{% schema %}
{
  "name": "Hero banner",

  "settings": [

    {
      "type": "header",
      "content": "Desktop"
    },

    {
      "type": "select",
      "id": "desktop_image_fit",
      "label": "Desktop image fitting",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "adapt",
          "label": "Adapt to image"
        }
      ],
      "default": "cover"
    },

    {
      "type": "range",
      "id": "desktop_height",
      "min": 60,
      "max": 120,
      "step": 5,
      "unit": "vh",
      "label": "Desktop height",
      "default": 100
    },
    {
  "type": "range",
  "id": "left_text_size_desktop",
  "min": 30,
  "max": 180,
  "step": 2,
  "unit": "px",
  "label": "Desktop left text size",
  "default": 96
},
{
  "type": "range",
  "id": "right_text_size_desktop",
  "min": 30,
  "max": 160,
  "step": 2,
  "unit": "px",
  "label": "Desktop right text size",
  "default": 72
},


    {
      "type": "header",
      "content": "Mobile"
    },
    {
  "type": "range",
  "id": "left_text_size_mobile",
  "min": 24,
  "max": 100,
  "step": 2,
  "unit": "px",
  "label": "Mobile left text size",
  "default": 52
},
{
  "type": "range",
  "id": "right_text_size_mobile",
  "min": 20,
  "max": 80,
  "step": 2,
  "unit": "px",
  "label": "Mobile right text size",
  "default": 36
},

    {
      "type": "select",
      "id": "mobile_image_fit",
      "label": "Mobile image fitting",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "adapt",
          "label": "Adapt to image"
        }
      ],
      "default": "cover"
    },

    {
      "type": "range",
      "id": "mobile_height",
      "min": 60,
      "max": 120,
      "step": 5,
      "unit": "vh",
      "label": "Mobile height",
      "default": 100
    },


    {
      "type": "header",
      "content": "Slider"
    },

    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },

    {
      "type": "range",
      "id": "slide_duration",
      "min": 2,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Time between slides",
      "default": 5
    },

    {
      "type": "range",
      "id": "transition_duration",
      "min": 400,
      "max": 2000,
      "step": 100,
      "unit": "ms",
      "label": "Compression speed",
      "default": 1000
    },

    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show arrows",
      "default": false
    },

    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show pagination dots",
      "default": false
    },


    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f7f5f2"
    }

  ],


  "blocks": [

    {
      "type": "slide",
      "name": "Slide",

      "settings": [

        {
          "type": "header",
          "content": "Images"
        },

        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },

        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },

        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },


        {
          "type": "header",
          "content": "Content"
        },

        {
          "type": "text",
          "id": "left_heading",
          "label": "Left heading",
          "default": "SEROTONINN"
        },

        {
          "type": "textarea",
          "id": "right_heading",
          "label": "Right heading",
          "default": "WHERE GLAM MEETS GRUNGE"
        },

        {
          "type": "text",
          "id": "bottom_heading",
          "label": "Bottom large heading"
        },

        {
          "type": "text",
          "id": "small_label",
          "label": "Small label"
        },

        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "SEE COLLECTION"
        },

        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },


        {
          "type": "header",
          "content": "Colors"
        },

        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#111111"
        },

        {
          "type": "color",
          "id": "accent_color",
          "label": "Accent color",
          "default": "#ff2e2e"
        }

      ]
    }

  ],

  "max_blocks": 8,

  "presets": [
    {
      "name": "Hero banner",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}